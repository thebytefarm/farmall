{
  "name": "@farmall/core",
  "version": "0.0.2",
  "description": "Composable artifact pipelines and safe repository writes for Farmall.",
  "homepage": "https://github.com/thebytefarm/farmall#readme",
  "bugs": {
    "url": "https://github.com/thebytefarm/farmall/issues"
  },
  "license": "MIT",
  "author": "Zac Rosenbauer <me@zrosenbauer.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebytefarm/farmall.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/artifacts/**",
    "dist/builtins/**",
    "dist/apply/**",
    "dist/config/**",
    "dist/diagnostics/**",
    "dist/filesystem/**",
    "dist/index.*",
    "dist/pipeline/**",
    "dist/planning/**",
    "dist/plugins/**",
    "dist/project/**",
    "dist/render/**",
    "dist/result.*",
    "dist/types.*",
    "!dist/**/*.test.*",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsgo -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/dotagents-lib": "^3.0.1",
    "jiti": "2.7.0",
    "jsonc-parser": "^3.3.1",
    "massaman": "^0.5.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=26"
  }
}
