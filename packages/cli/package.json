{
  "name": "farmall",
  "version": "0.0.2",
  "description": "Compile shared agent instructions, rules, skills, and subagents into platform-native files.",
  "keywords": [
    "agent",
    "agents",
    "agents-md",
    "ai",
    "claude-code",
    "cli",
    "codex",
    "cursor",
    "lint",
    "llm",
    "skills",
    "sync"
  ],
  "homepage": "https://github.com/thebytefarm/farmall#readme",
  "bugs": {
    "url": "https://github.com/thebytefarm/farmall/issues"
  },
  "license": "MIT",
  "author": "Zac Rosenbauer <me@zrosenbauer.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebytefarm/farmall.git",
    "directory": "packages/cli"
  },
  "bin": {
    "farmall": "./dist/index.js"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "!dist/**/*.test.*",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsgo -p tsconfig.json",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "dev": "node src/index.ts",
    "prepack": "pnpm --filter @farmall/core build && pnpm build",
    "test": "vitest run --exclude src/package-consumer.test.ts",
    "test:package-consumer": "vitest run src/package-consumer.test.ts"
  },
  "dependencies": {
    "@farmall/core": "workspace:*",
    "ink": "^7.1.1",
    "maltty": "1.0.0-rc.2",
    "massaman": "^0.5.1",
    "react": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1"
  },
  "engines": {
    "node": ">=26"
  }
}
